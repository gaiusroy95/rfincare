# Server-side only. Copy to .env in this folder.
# Never prefix these with VITE_ — that would bundle them into the browser.
# Mirror the same keys on Render / Cloud Run after local changes.

# --- Runtime ---
NODE_ENV=development
API_PORT=8080
# Developer panel at /development (password-protected). Set false in production.
ENABLE_DEV_PANEL=true
LOG_OTP=true
# SERVE_STATIC=false

# --- PostgreSQL (Neon, local docker compose, or any Postgres host) ---
DATABASE_URL=postgresql://rfincare:rfincare@127.0.0.1:5432/rfincare
DB_PROVIDER=postgres
# DATABASE_SSL=false
# DATABASE_POOL_SIZE=10
# Neon / remote Postgres: cold starts can take 30–60s
DATABASE_CONNECT_TIMEOUT_MS=60000
DATABASE_CONNECT_RETRIES=3

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Become Partner applicant session (default 7 days)
JWT_APPLICANT_ACCESS_TTL_SECONDS=604800

# Local: http://127.0.0.1:4028 / http://127.0.0.1:8080
# Production example: https://rfincare.com / https://rfincare.onrender.com
APP_PUBLIC_URL=http://127.0.0.1:4028
FRONTEND_URL=http://127.0.0.1:4028
PUBLIC_APP_URL=http://127.0.0.1:4028
PUBLIC_FRONTEND_URL=http://127.0.0.1:4028
API_PUBLIC_URL=http://127.0.0.1:8080
# Local + Vercel origins. On Vercel, VERCEL_URL is added automatically when API_CORS_ALLOW_VERCEL=true
API_CORS_ORIGIN=http://127.0.0.1:4028
API_CORS_ALLOW_VERCEL=true
# Set true when frontend and API are on different domains (Vercel + Render).
API_COOKIE_CROSS_SITE=true
API_COOKIE_SECURE=false
OAUTH_FRONTEND_CALLBACK=http://127.0.0.1:4028/oauth/callback

UPLOAD_DIR=./uploads

# --- Object storage (documents, logos, learning files, agent KYC) ---
# local = disk under UPLOAD_DIR (laptop only)
# s3    = S3-compatible API (Supabase Storage, AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
# Production Cloud Run/Render: prefer s3 or document files vanish after every restart.
# STORAGE_PROVIDER=s3
# S3_BUCKET=rfincare-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Supabase Storage S3 endpoint example:
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=
# S3_SIGNED_URL_TTL_SECONDS=3600
# UPLOAD_MAX_BYTES=26214400
# Acknowledge ephemeral local disk on Render/Cloud Run until S3 is ready:
ALLOW_EPHEMERAL_UPLOADS=true
# Hard-fail startup when S3 is missing on Cloud Run/Render:
# REQUIRE_DURABLE_STORAGE=true

# Admin password-reset OTP — three verifier emails (also configurable in Admin → Settings)
# ADMIN_VERIFIER_EMAIL_1=
# ADMIN_VERIFIER_EMAIL_2=
# ADMIN_VERIFIER_EMAIL_3=

# When API runs without the frontend folder (e.g. Render), frontend .env is stored here.
# FRONTEND_ENV_PATH=
# Optional: absolute path to built SPA (default: ../frontend/dist)
# FRONTEND_DIST=

# --- Email: prefer MSG91 for OTP + transactional (appointments, partner verification) ---
EMAIL_PRIMARY=msg91
# MSG91_AUTH_KEY=
MSG91_SENDER_ID=RFINCR
# MSG91_OTP_TEMPLATE_ID=
# MSG91_TEMPLATE_ID=
# MSG91_FLOW_TEMPLATE_ID=
# MSG91_WHATSAPP_TEMPLATE_ID=
# MSG91_WHATSAPP_NAMESPACE=
# MSG91_WHATSAPP_INTEGRATED_NUMBER=
# MSG91_WHATSAPP_LANGUAGE=en
# MSG91_WHATSAPP_INCLUDE_BUTTON=true
# MSG91_ROUTE=4
# MSG91_FETCH_TIMEOUT_MS=15000
MSG91_EMAIL_DOMAIN=mail.rfincare.com
MSG91_EMAIL_FROM_EMAIL=no-reply@mail.rfincare.com
MSG91_EMAIL_FROM_NAME=Rfincare
MSG91_EMAIL_OTP_TEMPLATE_ID=otp_vari
MSG91_EMAIL_OTP_VARIABLE=OTP_CODE
# Non-OTP mail ({{SUBJECT}} / {{BODY}}). Auto-provisions slug if unset and MSG91 email works.
MSG91_EMAIL_TRANSACTIONAL_TEMPLATE_ID=rfincare_notification
OTP_CHANNEL_TIMEOUT_MS=20000

# SMTP fallback (Gmail App Password). Used only if EMAIL_PRIMARY=smtp or MSG91 email fails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=you@gmail.com
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=15000

# --- Website enquiries (Talk to Expert + Contact Us) — inbox for email alerts ---
SALES_TEAM_EMAIL=support@rfincare.com
CONTACT_INQUIRY_EMAIL=support@rfincare.com

# --- OAuth ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

GOOGLE_TRANSLATE_API_KEY=
# DISABLE_FREE_TRANSLATE=true

# --- Surepass CIBIL / Experian PDF ---
# Console: https://kyc.surepass.io / sandbox.surepass.io
# Use sandbox host + token for SUREPASS_SANDBOX=true; production host for live paid tokens.
SUREPASS_BASE_URL=https://sandbox.surepass.io
SUREPASS_CIBIL_PATH=/api/v1/credit-report-cibil/fetch-report-pdf
SUREPASS_EXPERIAN_PATH=/api/v1/credit-report-experian/fetch-report-pdf
SUREPASS_SANDBOX=true
SUREPASS_TIMEOUT_MS=45000
SUREPASS_TOKEN=
SUREPASS_ID_NUMBER=
SUREPASS_PASSWORD=
# Live production:
# SUREPASS_BASE_URL=https://kyc-api.surepass.io
# SUREPASS_SANDBOX=false

# Optional TRAI consent annexure (homepage CIBIL → consent_evidence)
# CONSENT_TM_NAME=
# CONSENT_TM_ID=
# CONSENT_DLT_RECORD=

# --- Optional integrations ---
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ENGAGEMENT_CRON_SECRET=
# LEAD_TAT_CRON_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# BANK_VERIFY_PROVIDER=
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
